{
  "manifest_version": 3,
  "name": "aikeytake-zog Saver",
  "version": "0.1.0",
  "description": "Save the current page or PDF to your aikeytake-zog library.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Save to aikeytake-zog",
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Save this page to aikeytake-zog"
    }
  },
  "browser_specific_settings": {
    "gecko": { "id": "zog-saver@aikeytake.local", "strict_min_version": "121.0" }
  }
}
